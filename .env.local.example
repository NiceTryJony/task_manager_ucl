# =====================================================
# TaskFlow TMA — Environment Variables
# Copy this file to .env.local and fill in the values
# =====================================================

# Supabase (get from supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
CRON_SECRET=your_random_secret_here
PIN_SALT=your-random-string-here-change-in-production

# Telegram Bot (get from @BotFather)
BOT_TOKEN=1234567890:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App URL (set to your Vercel domain after deploy)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
